# GutGPT environment variables
# Keep secrets only on the AWS backend/server.
GROQ_API_KEY=replace-with-your-groq-api-key

# Comma-separated Shopify storefront origins.
# Example:
# ALLOWED_ORIGINS=https://www.yourshopifydomain.com,https://yourshopifydomain.com
ALLOWED_ORIGINS=https://www.yourshopifydomain.com,https://yourshopifydomain.com

# Optional AWS/runtime port. Defaults to 8000.
PORT=8000
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=10000

# Higher-capability model for multilingual input/output translation
GROQ_TRANSLATION_MODEL=openai/gpt-oss-20b
GROQ_TRANSLATION_MAX_TOKENS=1200
GROQ_TRANSLATION_TIMEOUT_SECONDS=25
GROQ_TRANSLATION_MAX_RETRIES=0
