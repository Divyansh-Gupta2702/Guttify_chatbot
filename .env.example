# GutGPT environment variables
# Keep secrets only on the backend server; never put them in the Shopify widget.
# Select one backend language model. Keep provider keys server-side.
GROQ_API_KEY=replace-with-your-groq-api-key
GUTGPT_LLM_PROVIDER=groq
# For Gemini instead, set GUTGPT_LLM_PROVIDER=gemini and configure:
# GEMINI_API_KEY=replace-with-your-gemini-api-key
# GEMINI_PAID_TIER_CONFIRMED=true
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GUTGPT_GENERAL_KNOWLEDGE_ENABLED=true
GUTGPT_COMPANY_KNOWLEDGE_ENABLED=true
GUTGPT_RESEARCH_ASSISTANT_ENABLED=true
GUTGPT_RESEARCH_TIMEOUT_SECONDS=5
GUTGPT_CONVERSATION_ROUTER_ENABLED=true
GUTGPT_SAFETY_PROVENANCE_ENABLED=true

# Required: generate a unique random secret of at least 32 bytes. Never commit the real value.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=gutgpt-api
JWT_AUDIENCE=gutgpt-guest-session

# Comma-separated Shopify storefront origins.
# Example:
# ALLOWED_ORIGINS=https://www.yourshopifydomain.com,https://yourshopifydomain.com
ALLOWED_ORIGINS=https://www.yourshopifydomain.com,https://yourshopifydomain.com

# Optional application listen port. Defaults to 8000.
PORT=8000
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=10000

# Required: PostgreSQL connection URL for direct/non-Compose runs.
# Docker Compose overrides DATABASE_URL with its internal postgres service URL.
DATABASE_URL=postgresql://gutgpt_user:replace-with-password@localhost:5432/gutgpt
# Required only when using Docker Compose; native PostgreSQL uses its own role password.
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# Required for protected admin endpoints; generate a unique random secret (32+ bytes).
GUTGPT_ADMIN_TOKEN=replace-with-a-unique-random-admin-token-at-least-32-bytes

# Groq call budget and safety controls. Production chat requests fail closed if
# PostgreSQL shared limiting is unavailable. Configure these against the actual
# model/account limits shown in the Groq console; values below are starting caps,
# not a claim about the provider's actual limits.
# English turns use the standard cap. Hinglish turns also need input and output
# translation calls, so they have a separate request budget.
GROQ_MAX_CALLS_PER_MESSAGE=2
GROQ_MAX_HINGLISH_CALLS_PER_MESSAGE=4
GROQ_MAX_CONCURRENT_PER_WORKER=4
GROQ_QUEUE_TIMEOUT_SECONDS=1.0
GROQ_CIRCUIT_FAILURE_THRESHOLD=5
GROQ_CIRCUIT_COOLDOWN_SECONDS=30
GROQ_SHARED_LIMITER_ENABLED=true
GROQ_SHARED_RPM_LIMIT=30
GROQ_SHARED_TPM_LIMIT=20000
GROQ_SHARED_MAX_CONCURRENT=8
# Output budgets are per call. NLU remains compact; answer budgets prevent
# otherwise valid educational answers from being cut off prematurely.
GROQ_OUTPUT_TOKEN_HARD_MAX=1200
GROQ_INTENT_MAX_OUTPUT_TOKENS=260
GROQ_NLU_MAX_TOKENS=500
GROQ_TRANSLATION_INPUT_MAX_TOKENS=700
GROQ_TRANSLATION_OUTPUT_MAX_TOKENS=1000
GROQ_GENERAL_ANSWER_MAX_OUTPUT_TOKENS=800
GROQ_COMPANY_ANSWER_MAX_OUTPUT_TOKENS=800
GROQ_RESEARCH_ANSWER_MAX_OUTPUT_TOKENS=900
# Used only when a call site has no task-specific budget.
GROQ_SHARED_OUTPUT_TOKEN_RESERVE=500
GROQ_NLU_TIMEOUT_SECONDS=12
