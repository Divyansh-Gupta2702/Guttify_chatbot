# GutGPT environment variables
# Keep secrets only on the AWS backend/server.
GROQ_API_KEY=replace-with-your-groq-api-key

# Required: generate a unique random secret of at least 32 bytes. Never commit the real value.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=gutgpt-api
JWT_AUDIENCE=gutgpt-guest-session

# Comma-separated Shopify storefront origins.
# Example:
# ALLOWED_ORIGINS=https://www.yourshopifydomain.com,https://yourshopifydomain.com
ALLOWED_ORIGINS=https://www.yourshopifydomain.com,https://yourshopifydomain.com

# Optional AWS/runtime port. Defaults to 8000.
PORT=8000
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=10000

# Higher-capability model for multilingual input/output translation
GROQ_TRANSLATION_MODEL=openai/gpt-oss-20b
GROQ_TRANSLATION_MAX_TOKENS=1200
GROQ_TRANSLATION_TIMEOUT_SECONDS=25
GROQ_TRANSLATION_MAX_RETRIES=0

# Required: PostgreSQL connection URL for direct/non-Compose runs.
# Docker Compose overrides DATABASE_URL with its internal postgres service URL.
DATABASE_URL=postgresql://gutgpt_user:replace-with-password@localhost:5433/gutgpt
# Required by docker-compose.yaml.
POSTGRES_PASSWORD=replace-with-a-strong-random-password
